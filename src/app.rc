#include <windows.h>

IDI_APP ICON "ranga-ytm.ico"
CONTROLE RCDATA "controle.js"

#ifdef RANGA_SPOT
#define APP_VERSION 1,0,0,0
#define APP_VERSION_TEXT "1.0.0"
#define APP_NAME "Ranga Spot"
#define APP_DESCRIPTION "Ranga Spot (app não oficial para ouvir o Spotify)"
#define APP_NOTICE "Ranga. Spotify é marca da Spotify AB; este app não é do Spotify."
#else
#define APP_VERSION 1,2,0,0
#define APP_VERSION_TEXT "1.2.0"
#define APP_NAME "Ranga YTM"
#define APP_DESCRIPTION "Ranga YTM (app não oficial do YouTube Music)"
#define APP_NOTICE "Ranga. YouTube Music é marca do Google; este app não é do Google."
#endif

1 VERSIONINFO
FILEVERSION APP_VERSION
PRODUCTVERSION APP_VERSION
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "FileDescription", APP_DESCRIPTION
      VALUE "ProductName", APP_NAME
      VALUE "ProductVersion", APP_VERSION_TEXT
      VALUE "FileVersion", APP_VERSION_TEXT
      VALUE "LegalCopyright", APP_NOTICE
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
